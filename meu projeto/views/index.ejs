<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Conversor de Moedas</title>
</head>
<body>
    <h1>Conversor de Real para Dólar</h1>
    <p>Taxa de câmbio atual: R$ 5,00 = U$ 1,00</p>
    
    <form action="/converter" method="GET">
        <label for="valorReais">Valor em R$:</label>
        <input type="number" name="valorReais" id="valorReais" step="0.01" required>
        <button type="submit">Converter</button>
    </form>
</body>
</html>